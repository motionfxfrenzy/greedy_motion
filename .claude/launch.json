{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:backend"
      ],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:frontend"
      ],
      "port": 3000
    },
    {
      "name": "design-handoff",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4600",
        "--directory",
        "design_handoff"
      ],
      "port": 4600
    },
    {
      "name": "text-flow-editor",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "experiments/gm-text-flow/editor/server.py",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "gm-editor",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "experiments/gm-editor/server.py",
        "8790"
      ],
      "port": 8790
    }
  ]
}