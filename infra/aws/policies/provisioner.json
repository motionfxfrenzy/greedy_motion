{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrRepoForWorker",
      "Effect": "Allow",
      "Action": ["ecr:CreateRepository", "ecr:DescribeRepositories", "ecr:PutLifecyclePolicy", "ecr:PutImageScanningConfiguration", "ecr:TagResource", "ecr:ListTagsForResource"],
      "Resource": "arn:aws:ecr:@REGION@:@ACCOUNT@:repository/@PROJECT@-@ENV@-worker"
    },
    {
      "Sid": "WorkerLogGroup",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:PutRetentionPolicy", "logs:TagResource"],
      "Resource": ["arn:aws:logs:@REGION@:@ACCOUNT@:log-group:/ecs/@PROJECT@-@ENV@-worker", "arn:aws:logs:@REGION@:@ACCOUNT@:log-group:/ecs/@PROJECT@-@ENV@-worker:*"]
    },
    { "Sid": "ListLogGroups", "Effect": "Allow", "Action": "logs:DescribeLogGroups", "Resource": "*" },
    {
      "Sid": "EcsCreateCluster",
      "Effect": "Allow",
      "Action": ["ecs:CreateCluster", "ecs:DescribeClusters", "ecs:TagResource"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "@REGION@" } }
    },
    {
      "Sid": "EcsWorkerService",
      "Effect": "Allow",
      "Action": ["ecs:CreateService", "ecs:UpdateService", "ecs:DescribeServices", "ecs:ListServices"],
      "Resource": ["arn:aws:ecs:@REGION@:@ACCOUNT@:service/@PROJECT@-@ENV@/*", "arn:aws:ecs:@REGION@:@ACCOUNT@:cluster/@PROJECT@-@ENV@"]
    },
    {
      "Sid": "LookAtTheNetwork",
      "Effect": "Allow",
      "Action": ["ec2:DescribeVpcs", "ec2:DescribeSubnets", "ec2:DescribeSecurityGroups", "ec2:DescribeNetworkInterfaces"],
      "Resource": "*"
    },
    {
      "Sid": "WorkerSecurityGroup",
      "Effect": "Allow",
      "Action": ["ec2:CreateSecurityGroup", "ec2:CreateTags", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupEgress"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "@REGION@" } }
    },
    {
      "Sid": "WorkerSecretsOnly",
      "Effect": "Allow",
      "Action": ["secretsmanager:CreateSecret", "secretsmanager:PutSecretValue", "secretsmanager:DescribeSecret", "secretsmanager:TagResource"],
      "Resource": "arn:aws:secretsmanager:@REGION@:@ACCOUNT@:secret:@PROJECT@/@ENV@/worker/*"
    },
    {
      "Sid": "CreateTheTwoWorkerRolesOnly",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:TagRole", "iam:UpdateAssumeRolePolicy", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies"],
      "Resource": ["arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-task", "arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-exec"]
    },
    {
      "Sid": "AttachOnlyTheEcsExecutionManagedPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-exec",
      "Condition": { "ArnEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" } }
    },
    {
      "Sid": "EcsServiceLinkedRoleFirstTime",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::@ACCOUNT@:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
      "Condition": { "StringEquals": { "iam:AWSServiceName": "ecs.amazonaws.com" } }
    },
    {
      "Sid": "PassWorkerRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ["arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-task", "arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-exec"],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    }
  ]
}
