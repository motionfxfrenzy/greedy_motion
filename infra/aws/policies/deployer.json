{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
    {
      "Sid": "EcrPushPullWorkerImageOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:CompleteLayerUpload", "ecr:DescribeImages",
        "ecr:DescribeRepositories", "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:PutImage", "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:@REGION@:@ACCOUNT@:repository/@PROJECT@-@ENV@-worker"
    },
    {
      "Sid": "EcsTaskDefinitions",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition", "ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "EcsUpdateWorkerServiceOnly",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService", "ecs:DescribeServices"],
      "Resource": "arn:aws:ecs:@REGION@:@ACCOUNT@:service/@PROJECT@-@ENV@/worker"
    },
    {
      "Sid": "EcsReadTasksInThisCluster",
      "Effect": "Allow",
      "Action": ["ecs:ListTasks", "ecs:DescribeTasks"],
      "Resource": "*",
      "Condition": { "ArnEquals": { "ecs:cluster": "arn:aws:ecs:@REGION@:@ACCOUNT@:cluster/@PROJECT@-@ENV@" } }
    },
    {
      "Sid": "PassOnlyTheWorkerRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-task",
        "arn:aws:iam::@ACCOUNT@:role/@PROJECT@-@ENV@-worker-exec"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "ReadWorkerLogs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents"],
      "Resource": "arn:aws:logs:@REGION@:@ACCOUNT@:log-group:/ecs/@PROJECT@-@ENV@-worker:*"
    }
  ]
}
