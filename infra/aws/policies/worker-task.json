{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadsAndAudioInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::@PROJECT@-@ENV@-uploads/*"
    },
    {
      "Sid": "WriteRenderOutputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::@PROJECT@-@ENV@-outputs/*"
    },
    {
      "Sid": "ListOwnBucketsOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::@PROJECT@-@ENV@-uploads", "arn:aws:s3:::@PROJECT@-@ENV@-outputs"]
    }
  ]
}
