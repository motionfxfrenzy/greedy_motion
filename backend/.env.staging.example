# Backend — staging. REFERENCE ONLY: set these on Railway environment "staging", service "backend".
# Railway: root directory = repository root, RAILWAY_DOCKERFILE_PATH=backend/Dockerfile.
APP_ENV=staging
RAILWAY_DOCKERFILE_PATH=backend/Dockerfile
HOST=::
LOG_LEVEL=info
CORS_ORIGINS=https://app.staging.<domain>,https://videosaas-*-<vercel-team>.vercel.app
# Worker over Railway private networking
PLAN_CONCURRENCY=4
RENDER_TIMEOUT_SECONDS=900
RENDER_RETRIES=2
PLANNER=anthropic
ANTHROPIC_API_KEY=<staging model key with spend limit>
ANTHROPIC_MODEL=
GEMINI_API_KEY=<staging Gemini API key with spend limit>

# From M4 (render outputs move to R2; the worker and backend do not share a disk on Railway):
# Required: render jobs and the pg-boss queue. Use the session pooler (pg-boss needs session features).
DATABASE_URL=<videosaas-staging Supabase session pooler URL>
DATABASE_POOL_SIZE=10
# AUTH_MODE=supabase
# SUPABASE_URL=https://<videosaas-staging project ref>.supabase.co
# SUPABASE_JWKS_URL=https://<videosaas-staging project ref>.supabase.co/auth/v1/.well-known/jwks.json
# EXPECTED_SUPABASE_PROJECT_REF=<videosaas-staging project ref>
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=<cloudflare account id>
# R2_ACCESS_KEY_ID=<backend token for videosaas-staging-* buckets>
# R2_SECRET_ACCESS_KEY=<backend token secret>
# R2_UPLOADS_BUCKET=videosaas-staging-uploads
# R2_OUTPUTS_BUCKET=videosaas-staging-outputs
# Durable user media (screenshots, brand files, audio) under media/; the local media dirs are only a cache.
# R2_MEDIA_BUCKET=greedymotion-staging-media
# Scale-to-zero render workers: the backend starts a Fargate task per queued render and each one exits after
# 10 idle minutes, so AWS bills only while rendering. Viewing a finished video never touches AWS (R2 signed URL).
# Credentials: the IAM user greedymotion-staging-backend-launcher (infra/aws/policies/backend-launcher.json).
# Before switching on, scale the always-on service down: infra/aws/deploy-worker.sh ondemand
# WORKER_LAUNCH=ecs
# AWS_ACCESS_KEY_ID=<backend-launcher access key>
# AWS_SECRET_ACCESS_KEY=<backend-launcher secret>
# ECS_REGION=ap-southeast-1
# ECS_CLUSTER=greedymotion-staging
# ECS_WORKER_TASK_DEFINITION=greedymotion-staging-worker
# ECS_SUBNETS=<public subnet ids, comma-separated>
# ECS_SECURITY_GROUPS=<worker security group id (no inbound rules)>
# ECS_WORKER_CONCURRENCY=2
# ECS_WORKER_MAX_TASKS=3
# ECS_USE_SPOT=1
# Signs the short-lived ?t= media tokens; 32+ random characters, shared by every replica.
# MEDIA_URL_SECRET=<openssl rand -base64 48>
# SENTRY_DSN=<sentry backend DSN>
# SENTRY_ENVIRONMENT=staging
# M5, Stripe test mode:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
