# Backend — staging. REFERENCE ONLY: set these on Railway environment "staging", service "backend".
# Railway: root directory = repository root, RAILWAY_DOCKERFILE_PATH=backend/Dockerfile.
APP_ENV=staging
RAILWAY_DOCKERFILE_PATH=backend/Dockerfile
HOST=::
LOG_LEVEL=info
CORS_ORIGINS=https://app.staging.<domain>,https://videosaas-*-<vercel-team>.vercel.app
# Worker over Railway private networking
PLAN_CONCURRENCY=4
RENDER_TIMEOUT_SECONDS=900
RENDER_RETRIES=2
PLANNER=anthropic
ANTHROPIC_API_KEY=<staging model key with spend limit>
ANTHROPIC_MODEL=
GEMINI_API_KEY=<staging Gemini API key with spend limit>

# From M4 (render outputs move to R2; the worker and backend do not share a disk on Railway):
# Required: render jobs and the pg-boss queue. Use the session pooler (pg-boss needs session features).
DATABASE_URL=<videosaas-staging Supabase session pooler URL>
DATABASE_POOL_SIZE=10
# AUTH_MODE=supabase
# SUPABASE_URL=https://<videosaas-staging project ref>.supabase.co
# SUPABASE_JWKS_URL=https://<videosaas-staging project ref>.supabase.co/auth/v1/.well-known/jwks.json
# EXPECTED_SUPABASE_PROJECT_REF=<videosaas-staging project ref>
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=<cloudflare account id>
# R2_ACCESS_KEY_ID=<backend token for videosaas-staging-* buckets>
# R2_SECRET_ACCESS_KEY=<backend token secret>
# R2_UPLOADS_BUCKET=videosaas-staging-uploads
# R2_OUTPUTS_BUCKET=videosaas-staging-outputs
# SENTRY_DSN=<sentry backend DSN>
# SENTRY_ENVIRONMENT=staging
# M5, Stripe test mode:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
