# Backend — local. Copy to backend/.env (gitignored); `npm run dev:backend` loads it.
APP_ENV=local
# local = Compose Postgres + disk + Compose worker (cloud settings are refused at startup); staging and production = hosted
# database + R2 (docs/ENVIRONMENTS.md). ALLOW_CLOUD_IN_LOCAL=1 is the explicit escape hatch.
# ALLOW_CLOUD_IN_LOCAL=
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Render jobs and the pg-boss render queue (docker compose up -d postgres)
DATABASE_URL=postgres://videosaas:videosaas@localhost:55432/videosaas
DATABASE_POOL_SIZE=10
# Planning jobs (Claude + audio) one backend replica runs at once
PLAN_CONCURRENCY=4
# Shared with the worker container (mounted there at /renders)
RENDER_OUTPUT_DIR=../var/renders
# A render attempt running longer than this is abandoned and retried; RENDER_RETRIES retries before failing
RENDER_TIMEOUT_SECONDS=900
RENDER_RETRIES=2
# Claude plans every video. The backend refuses to start without a key unless PLANNER=deterministic.
PLANNER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Defaults to claude-sonnet-4-6 when empty
ANTHROPIC_MODEL=
PLATE_MODEL=
# Google Gemini API: Lyria background music and Gemini TTS voiceover (optional; Sound options need it)
# Brand kits and generated audio, shared read-only with the worker
BRANDS_DIR=../var/brands
AUDIO_DIR=../var/audio

# From M3/M4:
# AUTH_MODE=none
# STORAGE_DRIVER=filesystem

# Account emails (confirmation code + link, password reset). Resend sends first; Brevo sends when Resend fails.
# Either key alone works. Both sending domains are greedymotion.com.
RESEND_API_KEY=
BREVO_API_KEY=
# Sign-up and password emails come from MAIL_FROM; the one-time welcome email (sent after an account is confirmed) comes from
# MAIL_WELCOME_FROM, and replies to it go to support@greedymotion.com. MAIL_APP_URL is where its "Open your workspace" button goes
# (defaults to the first HTTPS origin in CORS_ORIGINS).
# MAIL_FROM="GreedyMotion <noreply@greedymotion.com>"
# MAIL_WELCOME_FROM="GreedyMotion <hello@greedymotion.com>"
# MAIL_APP_URL=https://app.greedymotion.com
# Supabase Authentication > Auth Hooks > Send Email: point it at https://<backend>/v1/auth/email-hook and paste its secret here.
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...

# Auth: "none" for local dev; "supabase" verifies Supabase access tokens.
AUTH_MODE=none
# SUPABASE_URL=https://<project ref>.supabase.co
# EXPECTED_SUPABASE_PROJECT_REF=<project ref>

# Pro Editor entitlement
# The Pro editor is granted per user in the database: npm run grant:pro -w backend -- <email|uuid> (docs/PRO_EDITOR.md).
# How long this replica remembers a user's plan, in seconds (0 turns the cache off). A grant or revoke is seen within this long.
ENTITLEMENT_CACHE_SECONDS=30

# Material footage: backend needs ffmpeg on PATH. No provider calls during builds/tests.
VISUAL_IMAGE_MODEL=gemini-3.1-flash-image
VISUAL_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Positive integer maximum cumulative project reservation (not a provider billing cap).
# Estimates currently reserve $0.25/image and $1.60/8-second video; review when changing models.
VISUAL_MAX_BUDGET_USD=50

# Optional override for the hash-verified cloud author bundle (default: backend/cloud-author-skills)
# CLOUD_AUTHOR_SKILLS_DIR=

# Render workers: "external" (default) means local Docker keeps the worker running. "ecs" makes the backend
# start Fargate tasks on demand; see .env.staging.example.
# WORKER_LAUNCH=external

# Code-drawn plate scenes (requires STORAGE_DRIVER=r2 when PLATE_PIPELINE=worker).
# PLATE_PIPELINE=off
# Live browser preview for plate scenes ("on" or "off", default "off"; requires PLATE_PIPELINE=worker).
# Decided once per project on first entry to step 3 and persisted on app.plate_state.live_mode.
# PLATE_LIVE_PREVIEW=off
# Explicit operator rollback override ("1" flips existing live projects to clip mode and queues plate-render).
# PLATE_LIVE_FORCE_OFF=0
# Maximum concurrent fallback clip renders queued or running per project (default 16) and per-project worker claim cap (default 16).
# PLATE_PROJECT_CLIP_CAP=16
# PLATE_PROJECT_CAP=16
# Three-minute (180 s) grace window before a live-mode scene with no browser check report falls back to AWS worker rendering.
# PLATE_CHECK_GRACE_SECONDS=180
# When WORKER_LAUNCH=ecs: per-task slots (default 1 final render / 1 plate render per task) and operator task ceiling (default 32).
# ECS_WORKER_CONCURRENCY=1
# ECS_PLATE_CONCURRENCY=1
# ECS_WORKER_MAX_TASKS=32

# Per-step model routing (docs/MODEL_ROUTING.md). Unset = today's models.
# All-Gemini production/staging routing example (Argon for script/chat, 3.8 Flash for storyboard/scenes/planner):
# MODEL_DEFAULT=gemini:gemini-3.8-flash
# MODEL_SCRIPT=gemini:gemini-4-argon          # also scriptWrite, sceneInsert
# EFFORT_SCRIPT=low
# MODEL_REWRITE_BEAT=gemini:gemini-4-argon
# EFFORT_REWRITE_BEAT=low
# MODEL_ELEMENT_EDITS=gemini:gemini-4-argon
# EFFORT_ELEMENT_EDITS=low
# MODEL_DIRECTOR=gemini:gemini-3.8-flash
# EFFORT_DIRECTOR=medium
#
# Hybrid example (Opus for script, Gemini 3.8 Flash for scenes):
# MODEL_SCRIPT=anthropic:claude-opus-5-5
# MODEL_SCENE_WRITER=gemini:gemini-3.8-flash # MODEL_SCENE_REPAIR follows it
# EFFORT_SCENE_WRITER=high  MAX_TOKENS_SCENE_WRITER=24000
