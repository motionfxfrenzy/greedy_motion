# Backend — production. REFERENCE ONLY: set these on Railway environment "production", service "backend".
# Railway: root directory = repository root, RAILWAY_DOCKERFILE_PATH=backend/Dockerfile.
APP_ENV=production
RAILWAY_DOCKERFILE_PATH=backend/Dockerfile
HOST=::
LOG_LEVEL=info
CORS_ORIGINS=https://app.<domain>
# Backend planner concurrency; render worker runs on AWS ECS
PLAN_CONCURRENCY=4
RENDER_TIMEOUT_SECONDS=900
RENDER_RETRIES=2
PLANNER=anthropic
ANTHROPIC_API_KEY=<production model key with spend limit>
ANTHROPIC_MODEL=
GEMINI_API_KEY=<production Gemini API key with spend limit>

# Hosted queue and storage; see docs/MEDIA_R2_ROLLOUT.md for production setup.
# Required: render jobs and the pg-boss queue. Use the session pooler (pg-boss needs session features).
DATABASE_URL=<videosaas-production Supabase session pooler URL>
DATABASE_POOL_SIZE=10
# AUTH_MODE=supabase
# SUPABASE_URL=https://<videosaas-production project ref>.supabase.co
# SUPABASE_JWKS_URL=https://<videosaas-production project ref>.supabase.co/auth/v1/.well-known/jwks.json
# EXPECTED_SUPABASE_PROJECT_REF=<videosaas-production project ref>
# STORAGE_DRIVER=r2
# R2_ENDPOINT=https://<cloudflare account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<backend S3 access key scoped to greedymotion-production uploads, outputs and media buckets>
# R2_SECRET_ACCESS_KEY=<backend token secret>
# R2_UPLOADS_BUCKET=greedymotion-production-uploads
# R2_OUTPUTS_BUCKET=greedymotion-production-outputs
# Set explicitly before deploying MEDIA-03; otherwise config falls back to the uploads bucket.
# Durable user media under media/; the local media dirs become a cache for new durable writes.
# R2_MEDIA_BUCKET=greedymotion-production-media
# Keep the existing mount during rollout; remove only after the staging replica gate passes.
# PROJECTS_DIR=/data/projects
# BRANDS_DIR=/data/brands
# AUDIO_DIR=/data/audio
# RENDER_OUTPUT_DIR=/data/renders
# Scale-to-zero render workers: the backend starts a Fargate task per queued render and each one exits after
# 10 idle minutes, so AWS bills only while rendering. Viewing a finished video never touches AWS (R2 signed URL).
# Credentials: the IAM user greedymotion-production-backend-launcher (infra/aws/policies/backend-launcher.json).
# Before switching on, scale the always-on service down: infra/aws/deploy-worker.sh ondemand
# WORKER_LAUNCH=ecs
# AWS_ACCESS_KEY_ID=<backend-launcher access key>
# AWS_SECRET_ACCESS_KEY=<backend-launcher secret>
# ECS_REGION=ap-southeast-1
# ECS_CLUSTER=greedymotion-production
# ECS_WORKER_TASK_DEFINITION=greedymotion-production-worker
# ECS_SUBNETS=<public subnet ids, comma-separated>
# ECS_SECURITY_GROUPS=<worker security group id (no inbound rules)>
# ECS_WORKER_CONCURRENCY=2
# ECS_WORKER_MAX_TASKS=3
# ECS_USE_SPOT=1
# Signs the short-lived ?t= media tokens; 32+ random characters, stable and shared by every replica.
# MEDIA_URL_SECRET=<openssl rand -base64 48>
# SENTRY_DSN=<sentry backend DSN>
# SENTRY_ENVIRONMENT=production
# M5, Stripe live mode:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Material footage: backend needs ffmpeg on PATH. No provider calls during builds/tests.
VISUAL_IMAGE_MODEL=gemini-3.1-flash-image
VISUAL_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Positive integer maximum cumulative project reservation (not a provider billing cap).
# Estimates currently reserve $0.25/image and $1.60/8-second video; review when changing models.
VISUAL_MAX_BUDGET_USD=50

# Optional override for the hash-verified cloud author bundle (default: backend/cloud-author-skills)
# CLOUD_AUTHOR_SKILLS_DIR=
