{
  "name": "@videosaas/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:ownership": "node --env-file=.env test/ownership.mjs",
    "import:file-records": "node --env-file=.env scripts/import-file-records.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cors": "^11.0.0",
    "@google/genai": "^2.27.0",
    "@videosaas/contracts": "*",
    "fastify": "^5.0.0",
    "gsap": "^3.14.2",
    "hyperframes": "0.8.111",
    "jose": "^6.2.12",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
