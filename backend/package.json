{
  "name": "@videosaas/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:ownership": "node --env-file-if-exists=.env test/ownership.mjs",
    "import:file-records": "node --env-file=.env scripts/import-file-records.ts",
    "test:brand-files": "node --env-file-if-exists=.env test/brand-files.mjs",
    "test:media": "node test/media.mjs",
    "backfill:media": "node --env-file-if-exists=.env scripts/backfill-media.ts",
    "test:pro": "node test/pro.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@fastify/cors": "^11.0.0",
    "@google/genai": "^2.27.0",
    "@hyperframes/lint": "0.8.111",
    "@videosaas/contracts": "*",
    "animejs": "4.5.0",
    "fastify": "^5.0.0",
    "gsap": "^3.14.2",
    "hyperframes": "0.8.111",
    "jose": "^6.2.12",
    "p5": "2.3.4",
    "p5.brush": "2.2.3",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "roughjs": "4.6.6",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
