# Frontend — local. Copy to frontend/.env.local (gitignored); Next.js loads it automatically.
# Everything here is public by design (NEXT_PUBLIC_*): no secrets in the frontend.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:4000

# From M4 (Supabase CLI local stack):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SENTRY_DSN=


# Paddle.js (the /plans page). Both are required; the page throws if either is unset.
# NEXT_PUBLIC_PADDLE_ENVIRONMENT is "sandbox" (token starts test_) or "production" (token starts live_). Client-side tokens are public.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Live plate preview & Draft geometry budget (Step 3 Animation):
# NEXT_PUBLIC_DRAFT_TARGET_VERTICES sets the default target vertices per frame for unlisted Draft preview styles.
# Units: integer vertices per frame; valid range: [500, 2000000]; default fallback when unset or invalid: 75000.
# (Try 6000, 60000, or 75000. Because Next.js inlines NEXT_PUBLIC_* at build/startup time, rebuild or restart Next.js after changing.)
NEXT_PUBLIC_DRAFT_TARGET_VERTICES=75000

# Per-style Draft quality policy kill switch (default: enabled; set to "off" or "0" to disable the per-style table and use NEXT_PUBLIC_DRAFT_TARGET_VERTICES for all 31 styles):
# NEXT_PUBLIC_DRAFT_STYLE_POLICY=on

# Optional testing force override: forces one vertex target across all 31 styles (listed and unlisted), overriding the per-style table (unset/off by default):
# NEXT_PUBLIC_DRAFT_TARGET_FORCE=
