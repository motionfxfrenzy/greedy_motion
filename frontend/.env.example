# Frontend — local. Copy to frontend/.env.local (gitignored); Next.js loads it automatically.
# Everything here is public by design (NEXT_PUBLIC_*): no secrets in the frontend.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:4000

# From M4 (Supabase CLI local stack):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
