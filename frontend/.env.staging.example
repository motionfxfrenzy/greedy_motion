# Frontend — staging. REFERENCE ONLY: set these in the Vercel "Preview" environment (branch `staging` + PR previews).
# Vercel project Root Directory: frontend
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_API_URL=https://api.staging.<domain>

