# Worker — local. Copy to worker/.env (gitignored); docker compose loads it for the worker service.
# No model key, auth secret, or user tokens ever go to the worker.
APP_ENV=local
PORT=8080
HOST=0.0.0.0
RENDER_MAX_SECONDS=300
RENDER_MAX_DISK_MB=2048
HYPERFRAMES_NO_TELEMETRY=1
HYPERFRAMES_NO_UPDATE_CHECK=1

# Render queue + job rows. compose.yaml already sets this for the worker container.
DATABASE_URL=postgres://videosaas:videosaas@postgres:5432/videosaas
# Renders per replica (each needs ~1 GB RAM). Scale out with `docker compose up -d --scale worker=N`.
RENDER_CONCURRENCY=1
DRAIN_SECONDS=25

# Later (MEDIA-02):
# STORAGE_DRIVER=filesystem
