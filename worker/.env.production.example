# Worker — production. REFERENCE ONLY: set these on Railway environment "production", service "worker".
# Railway: root directory = repository root, RAILWAY_DOCKERFILE_PATH=worker/Dockerfile. No public domain.
APP_ENV=production
RAILWAY_DOCKERFILE_PATH=worker/Dockerfile
PORT=8080
HOST=::
RENDER_MAX_SECONDS=300
RENDER_MAX_DISK_MB=2048
HYPERFRAMES_NO_TELEMETRY=1
HYPERFRAMES_NO_UPDATE_CHECK=1
# Set from benchmark p95 render + upload time (Railway default is 0)
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=<measured>

# From M4:
# Required: the worker consumes the render-video queue and writes progress to app.render_jobs.
DATABASE_URL=<videosaas-production Supabase session pooler URL>
# Renders per replica. Each render needs ~1 GB RAM; scale out with replicas, not this.
RENDER_CONCURRENCY=1
# Seconds a SIGTERM waits for running renders; set RAILWAY_DEPLOYMENT_DRAINING_SECONDS a little higher.
DRAIN_SECONDS=25
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=<cloudflare account id>
# R2_ACCESS_KEY_ID=<worker token: read uploads, write outputs>
# R2_SECRET_ACCESS_KEY=<worker token secret>
# R2_UPLOADS_BUCKET=videosaas-production-uploads
# R2_OUTPUTS_BUCKET=videosaas-production-outputs
# SENTRY_DSN=<sentry worker DSN>
# SENTRY_ENVIRONMENT=production
